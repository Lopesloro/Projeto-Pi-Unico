# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── OpenAI (GPT-4o) ──────────────────────────────────────────────────────────
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# ─── Google Gemini (legado — ainda usado no frontend) ─────────────────────────
GEMINI_API_KEY=AIzaSy...

# ─── Gmail API (OAuth2) ───────────────────────────────────────────────────────
# Guia de setup: https://developers.google.com/gmail/api/quickstart/nodejs
# 1. Crie um projeto no Google Cloud Console
# 2. Ative a Gmail API
# 3. Configure OAuth2 → Credentials → OAuth Client ID (tipo: Web)
# 4. Use https://developers.google.com/oauthplayground para obter o refresh_token
GMAIL_CLIENT_ID=xxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-...
GMAIL_REFRESH_TOKEN=1//04...
GMAIL_USER=seu-email@gmail.com

